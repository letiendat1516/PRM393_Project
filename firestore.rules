rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ──────────────────────────────────────────────────────────
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(uid())); }
    function userExists() { return exists(/databases/$(database)/documents/users/$(uid())); }
    function role() { return userExists() ? userDoc().data.role : ''; }
    function active() { return userExists() ? (userDoc().data.isActive != false) : true; }
    function isAdmin() { return signedIn() && role() == 'admin' && active(); }
    function isEmployer() { return signedIn() && role() == 'employer' && active(); }
    function isSeeker() { return signedIn() && role() == 'job_seeker' && active(); }
    function isOwner(id) { return signedIn() && uid() == id; }
    function onlyKeys(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ── accounts (users / job_seeker / employer / admin tables) ─────────
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isOwner(userId)
        && request.resource.data.role in ['job_seeker', 'employer', 'admin']
        && request.resource.data.isActive == true;
      allow update: if isAdmin()
        || (isOwner(userId) && onlyKeys(['fullName','phone','photoUrl','headline','city','website','fcmTokens','updatedAt']));
      allow delete: if isAdmin();

      match /aiSessions/{sessionId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /jobSeekerProfiles/{userId} {
      allow read: if isOwner(userId) || isEmployer() || isAdmin();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /employerProfiles/{userId} {
      allow read: if true; // CompanyDetailPage is public
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ── catalog ──────────────────────────────────────────────────────────
    match /categories/{id} {
      allow read: if true;
      // JobService auto-creates categories by name and bumps jobCount on job create/delete
      allow create, update: if isAdmin() || isEmployer();
      allow delete: if isAdmin();
    }
    match /skills/{id} {
      allow read: if true;
      // upsert (set-merge) on job create / profile skills
      allow create, update: if isAdmin() || isEmployer() || isSeeker();
      allow delete: if isAdmin();
    }

    // ── jobs ─────────────────────────────────────────────────────────────
    match /jobs/{jobId} {
      // `resource == null` → a doc-get on a missing id yields exists=false
      // (web backend answers 404 'Không tìm thấy tin tuyển dụng.').
      allow read: if resource == null
        || (resource.data.isApproved == true && resource.data.status == 'OPEN')
        || (signedIn() && resource.data.employerId == uid())
        || isAdmin();
      // Employer-created jobs MUST default to isApproved=false and start in
      // DRAFT or OPEN (web backend sets this deterministically from
      // REQUIRE_JOB_APPROVAL — bypassing this skips moderation).
      allow create: if isAdmin()
        || (isEmployer()
            && request.resource.data.employerId == uid()
            && request.resource.data.isApproved == false
            && request.resource.data.status in ['DRAFT', 'OPEN']);
      allow update: if isAdmin()
        || (isEmployer() && resource.data.employerId == uid()
            && request.resource.data.employerId == uid()
            && request.resource.data.isApproved == resource.data.isApproved)
        || (isSeeker() && onlyKeys(['applicationsCount','updatedAt']));
      allow delete: if isAdmin() || (isEmployer() && resource.data.employerId == uid());
    }

    // ── applications + status history ───────────────────────────────────
    match /applications/{appId} {
      // Doc ids are `{seekerUid}_{jobId}`: a seeker may probe their own
      // not-yet-existing application (duplicate check) → `resource == null`.
      allow get: if isAdmin()
        || (signedIn() && resource == null && appId.split('_')[0] == uid())
        || (signedIn() && resource != null
            && (resource.data.jobSeekerId == uid() || resource.data.employerId == uid()));
      allow list: if isAdmin()
        || (signedIn() && (resource.data.jobSeekerId == uid() || resource.data.employerId == uid()));
      allow create: if isSeeker()
        && request.resource.data.jobSeekerId == uid()
        && request.resource.data.status == 'SUBMITTED';
      allow update: if isAdmin()
        || (isEmployer() && resource.data.employerId == uid()
            && onlyKeys(['status','updatedAt','matchScore','recommendationReason']));
      allow delete: if isAdmin();

      match /statusHistory/{historyId} {
        allow read: if isAdmin()
          || (signedIn() && (get(/databases/$(database)/documents/applications/$(appId)).data.jobSeekerId == uid()
              || get(/databases/$(database)/documents/applications/$(appId)).data.employerId == uid()));
        // Only parties to the application may write history (append-only audit).
        //
        // Special case: the GENESIS row is written in the same transaction
        // that creates the parent applications/{appId} doc (seeker apply
        // flow). Firestore rules' get() reads committed state only, so the
        // parent doesn't exist yet from the rule engine's point of view —
        // allow the genesis row by its shape instead (SUBMITTED, no
        // oldStatus, seeker role, matching uid). The applications create
        // rule guarantees the parent is correctly scoped to the same
        // seeker, so the two writes agree on identity.
        allow create: if signedIn()
          && request.resource.data.changedBy == uid()
          && (isAdmin()
              || (
                isSeeker()
                && !('oldStatus' in request.resource.data)
                && request.resource.data.newStatus == 'SUBMITTED'
                && request.resource.data.changedByRole == 'job_seeker'
              )
              || (
                exists(/databases/$(database)/documents/applications/$(appId))
                && (
                  get(/databases/$(database)/documents/applications/$(appId)).data.jobSeekerId == uid()
                  || get(/databases/$(database)/documents/applications/$(appId)).data.employerId == uid()
                )
              ));
        allow update, delete: if false; // append-only audit
      }
    }

    // ── resumes + AI analyses ────────────────────────────────────────────
    match /resumes/{resumeId} {
      allow read: if isAdmin() || isEmployer() || (signedIn() && resource.data.jobSeekerId == uid());
      allow create: if isSeeker() && request.resource.data.jobSeekerId == uid();
      allow update, delete: if isAdmin() || (signedIn() && resource.data.jobSeekerId == uid());

      match /aiAnalyses/{analysisId} {
        allow read: if isAdmin() || isEmployer()
          || get(/databases/$(database)/documents/resumes/$(resumeId)).data.jobSeekerId == uid();
        allow write: if get(/databases/$(database)/documents/resumes/$(resumeId)).data.jobSeekerId == uid();
      }
    }

    match /jobRecommendations/{id} {
      // Employers read the (seeker, job) recommendation on the review page
      // (web: application.job_recommendation[0]).
      allow get: if isAdmin() || isEmployer()
        || (signedIn() && (resource == null || resource.data.jobSeekerId == uid()));
      allow list: if isAdmin() || isEmployer() || (signedIn() && resource.data.jobSeekerId == uid());
      allow write: if isSeeker() && request.resource.data.jobSeekerId == uid();
    }

    match /savedJobs/{id} {
      allow get: if isSeeker() && (resource == null || resource.data.jobSeekerId == uid());
      allow list: if isSeeker() && resource.data.jobSeekerId == uid();
      allow create: if isSeeker() && request.resource.data.jobSeekerId == uid();
      allow update, delete: if isSeeker() && resource.data.jobSeekerId == uid();
    }

    // ── notifications ────────────────────────────────────────────────────
    match /notifications/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.recipientId == uid());
      // Prevent cross-user spoofing: validate type whitelist + require a non-self
      // recipient (an employer notifies a seeker, a seeker notifies an employer,
      // or an admin broadcasts). Backend writes come from the authoritative
      // server; from the client we gate on these shape invariants.
      allow create: if signedIn()
        && request.resource.data.recipientId is string
        && request.resource.data.type in ['APPLICATION_STATUS','NEW_APPLICATION','JOB_APPROVED','JOB_REJECTED','EMPLOYER_VERIFIED','SYSTEM']
        && (isAdmin() || request.resource.data.recipientId != uid());
      allow update: if isAdmin() || (signedIn() && resource.data.recipientId == uid() && onlyKeys(['isRead']));
      allow delete: if isAdmin() || (signedIn() && resource.data.recipientId == uid());
    }

    // ── AI logs & system configuration ──────────────────────────────────
    match /aiMatchingLogs/{id} {
      allow read: if isAdmin();
      // Migration 002 drops NOT NULL on ai_matching_log.job_seeker_id so
      // anonymous /viec-lam AI matching can log a row. Permit null-seeker
      // writes OR a signed-in writer whose uid matches jobSeekerId.
      allow create: if (!('jobSeekerId' in request.resource.data)
                        || request.resource.data.jobSeekerId == null
                        || (signedIn() && request.resource.data.jobSeekerId == uid()))
                    && request.resource.data.task is string
                    && request.resource.data.success is bool;
      allow update, delete: if isAdmin();
    }

    match /systemConfigurations/{key} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ── chat ─────────────────────────────────────────────────────────────
    match /chats/{chatId} {
      allow read: if signedIn() && uid() in resource.data.participants;
      allow create: if signedIn() && uid() in request.resource.data.participants;
      allow update: if signedIn() && uid() in resource.data.participants;
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if signedIn()
          && uid() in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if signedIn()
          && request.resource.data.senderId == uid()
          && uid() in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow update, delete: if false;
      }
    }
  }
}
